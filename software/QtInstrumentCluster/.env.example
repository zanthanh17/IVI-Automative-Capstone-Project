# Copy this file to .env and fill in your values
# .env is gitignored — never commit real tokens

# Mapbox access token (public token, starts with pk.)
# Get yours at: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_token_here
# Qt5 navigation uses fixed style: mapbox://styles/mapbox/navigation-guidance-night-v2
# (MAPBOX_STYLE_URL kept only for backward compatibility with scripts/tools)
MAPBOX_STYLE_URL=mapbox://styles/mapbox/navigation-guidance-night-v2
# Map mode is Mapbox-only:
# - Map style, geocoding, and directions all require this token.

# On-screen keyboard locale for text boxes (Qt Virtual Keyboard)
# vi_VN = Vietnamese layout
QT_VIRTUALKEYBOARD_LOCALE=vi_VN

# Optional weather location (required for Weather API refresh)
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_CITY=
