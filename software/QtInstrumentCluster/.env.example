# Copy this file to .env and fill in your values
# .env is gitignored — never commit real tokens

# Mapbox access token (public token, starts with pk.)
# Get yours at: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_token_here
# Routing provider mode is automatic:
# - With token: Mapbox Directions (driving-traffic)
# - Without token: OSRM demo server

# Optional weather location (required for Weather API refresh)
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_CITY=
